<% layout("/layouts/boilerplate") %>

<script>
    const listingCoordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const listingTitle = "<%= listing.title %>";
</script>

<div class="row">
    <!-- Listing Title -->
    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mt-3">
        <h4><b><%= listing.title %></b></h4>
    </div>

    <!-- Main Card -->
    <div class="card col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 show-card border-0 mb-3">
        <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2 text-capitalize position-absolute" 
            style="top: 0.5rem; right: 1.25rem; z-index: 2;">
            <i class="fa-solid fa-tag me-1 text-danger"></i>
            <%= listing.category || 'Trending' %>
        </span>
        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
            style="height: 400px; width: 100%; object-fit: cover;"
        />

        <div class="card-body mt-2 p-0 pt-3">
            <p class="mb-3 text-muted">
                Hosted by <b>@<%= listing.owner.username %></b>
            </p>

            <p class="text-dark mb-3 fs-6 lh-base">
                <%= listing.description %>
            </p>

            <p class="mb-0 fw-bold">
                <i class="fa-solid fa-indian-rupee-sign me-0 text-success"></i>
                <b><%= listing.price.toLocaleString("en-IN") %></b> / night
            </p>

        </div>
    </div>

    <!-- Owner Actions -->
    <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-0 d-flex gap-3">
            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn styled-btn px-4"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="m-0"
            >
                <button class="btn btn-dark px-4">Delete</button>
            </form>
        </div>
    <% } %>

    <!-- Reviews Section -->
    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
        <% if(currUser){ %>
            <hr class="my-4" />
            <h5 class="mb-3 fw-bold">Leave a review</h5>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
                novalidate
                class="needs-validation mb-3"
            >
                <div class="mb-0">
                    <label for="rating" class="form-label text-muted medium fw-semibold">Rating</label>
                    <fieldset class="starability-grow">
                        <input 
                            type="radio" 
                            id="no-rate" 
                            class="input-no-rate" 
                            name="review[rating]" 
                            value="1" 
                            checked aria-label="No rating." 
                        />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label text-muted medium fw-semibold">Comment</label>
                    <textarea
                        name="review[comment]"
                        id="comment"
                        rows="3"
                        class="form-control rounded-3"
                        placeholder="Write your review here..."
                        required
                    ></textarea>
                    <div class="invalid-feedback">
                        Please add some comment for review
                    </div>
                </div>

                <!-- Simple, clean, branded button -->
                <button class="btn btn-outline-dark btn-md py-1.5 rounded-3 fw-medium">Submit</button>
            </form>
            <!-- <hr class="my-4" /> -->
        <% } %>

        <% if (listing.reviews.length > 0) { %>
            <div class="row">
                <h5 class="mb-3 fw-bold">All Reviews</h5>
                <% for(review of listing.reviews){ %>
                    <div class="col-12 col-md-6 mb-3">
                        <!-- Compact, lightweight review card -->
                        <div class="card border rounded-3 p-3 bg-light bg-opacity-25 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark">@<%= review.author.username %></span>
                                <% if (currUser && currUser._id.equals(review.author._id)) { %>
                                    <form
                                        method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        class="m-0"
                                    >
                                        <button class="btn btn-sm btn-link text-dark text-decoration-none p-0" title="Delete review">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </div>

                            <p 
                                class="starability-result card-text mb-2" 
                                data-rating="<%= review.rating %>"
                            ></p>
                            <p class="card-text text-secondary mb-0 small"><%= review.comment %></p>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
        <hr class="my-4" />
    </div>


    <!-- Map Section -->
    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-3">
        <h4 class="mb-2"><b>Where you'll be</b></h4>
        <p class="mb-2">
                <i class="fa-solid fa-location-dot text-danger"></i>
                <%= listing.location %>, <%= listing.country %>
        </p>
        <div id="map" class="rounded-4 shadow-sm" style="height: 400px; width: 100%;"></div>
    </div>
</div>

<script src="/js/map.js"></script>