<% layout("/layouts/boilerplate") %>
<body>
    <div class="row" style="margin-top: 0rem;">
        <div class="col-8 offset-2">
            <!-- <h3>Edit Listing</h3> --><br />
            <form 
            method="POST" 
            action="/listings/<%= listing._id %>?_method=PUT"
            novalidate 
            class="needs-validation"
            enctype="multipart/form-data"
            >
                
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input
                type="text"
                id="title"
                value="<%= listing.title %>"
                name="listing[title]"
                class="form-control"
                required
            />
            <div class="valid-feedback">Title looks good!</div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea
                name="listing[description]"
                id="description"
                class="form-control"
                required
            ><%= listing.description %></textarea>
            <div class="invalid-feedback">Add a short description</div>
        </div>

        <div class="mb-3">
            Original Listing Image <br />
            <img src="<%= originalImageUrl %>" style="width:250px;">
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image</label>
            <input
                type="file"
                id="image"
                name="listing[image]"
                class="form-control"
            />
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input
                type="text"
                id="location"
                value="<%= listing.location %>"
                name="listing[location]"
                class="form-control"
                required
            />
            <div class="invalid-feedback">Enter a valid Location</div>
        </div>

        <div class="row">

            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
                type="number"
                id="price"
                value="<%= listing.price %>"
                name="listing[price]"
                class="form-control"
                required
            />
            <div class="invalid-feedback">Enter a valid Price</div>
        </div>

            <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
                type="text"
                id="country"
                value="<%= listing.country %>"
                name="listing[country]"
                class="form-control"
                required
            />
            <div class="invalid-feedback">Enter a valid country name</div>
        </div>

        </div>

        <button class="btn btn-dark styled-btn">Edit</button>

    </form>
        </div>
        
    </div>
</body>
