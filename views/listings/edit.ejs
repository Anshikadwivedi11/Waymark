<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3 mb-2">
    <div class="col-12 col-md-8 offset-md-2">
        <h3 class="fw-semibold mb-3">Edit Listing Details</h3>
            <form 
                method="POST" 
                action="/listings/<%= listing._id %>?_method=PUT"
                novalidate 
                class="needs-validation"
                enctype="multipart/form-data"
            >
                
                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input
                        type="text"
                        id="title"
                        value="<%= listing.title %>"
                        name="listing[title]"
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Title looks good!</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea
                        name="listing[description]"
                        id="description"
                        class="form-control"
                        required
                    ><%= listing.description %></textarea>
                    <div class="invalid-feedback">Add a short description</div>
                </div>

                <!-- Original Image Preview -->
                <div class="mb-3">
                    Original Listing Image <br />
                    <img src="<%= originalImageUrl %>" style="width:250px;">
                </div>

                <!-- New Image Upload -->
                <div class="mb-3">
                    <label for="image" class="form-label">Upload New Image</label>
                    <input
                        type="file"
                        id="image"
                        name="listing[image]"
                        class="form-control"
                    />
                </div>

                <!-- Price & Category Row (50/50) -->
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input
                            type="number"
                            id="price"
                            value="<%= listing.price %>"
                            name="listing[price]"
                            class="form-control"
                            required
                        />
                        <div class="invalid-feedback">Enter a valid Price</div>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label for="category" class="form-label">Category</label>
                        <select
                            name="listing[category]"
                            id="category"
                            class="form-select"
                            required
                        >
                            <option value="iconic-cities" <%= listing.category === "iconic-cities" ? "selected" : "" %>>Iconic Cities</option>
                            <option value="lakefront" <%= listing.category === "lakefront" ? "selected" : "" %>>Lakefront</option>
                            <option value="beach" <%= listing.category === "beach" ? "selected" : "" %>>Beach</option>
                            <option value="mountains" <%= listing.category === "mountains" ? "selected" : "" %>>Mountains</option>
                            <option value="cabins" <%= listing.category === "cabins" ? "selected" : "" %>>Cabins</option>
                            <option value="castles" <%= listing.category === "castles" ? "selected" : "" %>>Castles</option>
                            <option value="islands" <%= listing.category === "islands" ? "selected" : "" %>>Islands</option>
                            <option value="farms" <%= listing.category === "farms" ? "selected" : "" %>>Farms</option>
                            <option value="arctic" <%= listing.category === "arctic" ? "selected" : "" %>>Arctic</option>
                            <option value="camping" <%= listing.category === 'camping' ? 'selected' : '' %>>Camping</option>
                        </select>
                        <div class="invalid-feedback">Please select a category</div>
                    </div>
                </div>

                <!-- Location & Country Row (50/50) -->
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input
                            type="text"
                            id="location"
                            value="<%= listing.location %>"
                            name="listing[location]"
                            class="form-control"
                            required
                        />
                        <div class="invalid-feedback">Enter a valid Location</div>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input
                            type="text"
                            id="country"
                            value="<%= listing.country %>"
                            name="listing[country]"
                            class="form-control"
                            required
                        />
                        <div class="invalid-feedback">Enter a valid country name</div>
                    </div>
                </div>

                <button class="btn styled-btn px-4 py-2 mt-2 mb-2 rounded-3 fw-semibold">Save Changes</button>

            </form>
        </div>
    </div>
</body>