<style>
.logo {
  font-size: 1.4rem;
  color: rgb(253, 8, 73) !important;
  text-decoration: none;
  font-weight: 700;
}

/* 1. The Pill Shape */
.search-bar-pill {
  display: flex;
  align-items: center;
  width: 100%;
  height: 3rem;
  padding: 0.35rem 0.45rem 0.35rem 1.25rem;
  border: 1px solid #ddd;
  border-radius: 50rem;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  background: #fff;
}

/* 2. Transparent text input */
.search-bar-pill .search-input {
  border: none !important;
  box-shadow: none !important;
  background: transparent;
  padding: 0;
  font-size: 0.95rem;
}

/* 3. Red circular button */
.btn-search-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 50%;
  background-color: rgb(253, 8, 73);
  color: #fff;
  border: none;
  flex-shrink: 0;
}

.btn-search-circle:hover {
  background-color: rgb(220, 5, 60);
  color: #fff;
}

@media (min-width: 768px) {
  .search-bar-pill {
    width: 26rem;
  }
}

/* Mobile-only menu fix */
@media (max-width: 767.98px) {
  .navbar-collapse {
    background-color: #ffffff;
    padding: 1rem 0.5rem;
  }

  .search-form-wrapper {
    margin: 1rem 0 !important;
  }

  .navbar-nav .nav-link {
    padding: 0.5rem 0;
  }
}
</style>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
  <div class="container-fluid">
    
    <!-- Left Logo (Clickable Compass + Waymark together) -->
    <a class="navbar-brand d-flex align-items-center logo" href="/listings">
      <i class="fa-regular fa-compass me-2"></i>
      <span class="fs-3">Waymark</span>
    </a>

    <!-- Hamburger icon for mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation container: justify-content-between pushes search to center and links to the far right -->
    <div class="collapse navbar-collapse justify-content-between" id="navbarNavAltMarkup">
      
      <!-- Search Bar in Center -->
      <form class="d-flex my-2 my-md-0 mx-md-auto" role="search" action="/listings" method="GET">
        <div class="search-bar-pill">
          <input 
            class="form-control search-input" 
            type="search" 
            placeholder="Search destinations..." 
            name="search"
            aria-label="Search"
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          />

          <% if (typeof category !== 'undefined' && category) { %>
            <input type="hidden" name="category" value="<%= category %>" />
          <% } %>

          <button class="btn btn-search-circle" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </form>

      <!-- Right links: pinned to the far right edge -->
      <div class="navbar-nav text-nowrap">
        <a class="nav-link" href="/listings/new">Become a host</a>
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if (currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>

    </div>
  </div>
</nav>